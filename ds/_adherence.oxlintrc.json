{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/blocks/**",
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/layout/**",
              "ui_kits/social/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|gold|violet|ink)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'gold' | 'violet' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|block|disabled|href|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, as, block, disabled, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gold|gradient|outline|outlineInk|pill|pillViolet)$/]",
        "message": "<Button> variant must be one of 'gold' | 'gradient' | 'outline' | 'outlineInk' | 'pill' | 'pillViolet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:a|button)$/]",
        "message": "<Button> as must be one of 'a' | 'button'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|tint|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, tint, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|raised|ink|glass)$/]",
        "message": "<Card> tone must be one of 'paper' | 'raised' | 'ink' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tint'] > Literal[value!=/^(?:gold|violet)$/]",
        "message": "<Card> tint must be one of 'gold' | 'violet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoinCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:member|layout|tone|coinSize|key|ref|className|style|children)$/]",
        "message": "<CoinCard> doesn't accept that prop. Declared props: member, layout, tone, coinSize."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoinCard'] > JSXAttribute[name.name='member'] > Literal[value!=/^(?:luko|byko)$/]",
        "message": "<CoinCard> member must be one of 'luko' | 'byko'."
