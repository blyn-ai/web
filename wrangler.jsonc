{
  // Cloudflare Workers, static assets only — there is no server-side code and no
  // build step. `npx wrangler deploy` uploads the repository as the site root,
  // minus whatever .assetsignore lists.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blynai",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
